<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <!-- 主行为树 -->
  <BehaviorTree ID="MainTree">
    <Sequence>
        <Sequence>
            <!-- 比赛类型检查 -->
            <LogMessage message="检查比赛类型，比赛类型为：{competition_type}"/>
            <CheckValue value="{competition_type}" expected="1" operator="eq"/>
            <LogMessage message="比赛类型通过"/>

            <!-- 比赛阶段检查 -->
            <LogMessage message="检查比赛阶段，比赛阶段为：{competition_stage}"/>
            <CheckValue value="{competition_stage}" expected="4" operator="eq"/>
            <LogMessage message="比赛阶段通过，比赛中"/>
            <!-- 剩余时间检查 -->
            <LogMessage message="剩余比赛时间：{stage_time}"/>
            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
            <LogMessage message="比赛还有时间，比赛中"/>
            <AutoAimManager is_auto_aim = "1"
                            auto_aim_mode = "1"
                            targets='[{"type":1,"priority":50},
                                      {"type":2,"priority":30},
                                      {"type":3,"priority":30},
                                      {"type":4,"priority":40},
                                      {"type":5,"priority":30},
                                      {"type":6,"priority":100},
                                      {"type":7,"priority":1}]'
                            is_gimbal_patrol = "1"
                            yaw_degrees = "45.5"
                            is_reached = "1" />
        </Sequence>

        <Fallback> <!-- 血量分支判断-->
            <!-- 高血量分支 -->
            <Sequence>
                <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                <LogMessage message="血量健康，前往占点区"/>
                <Fallback>
                    <!-- 正常逻辑 -->
                    <Sequence>
                        <Fallback>
                            <CheckValue value="{friend_outpost}" expected="0" operator="gt"/>
                            <DoubleCheckValue value="{trigger_point_x}" expected="0" operator="ne"/>
                            <DoubleCheckValue value="{trigger_point_y}" expected="0" operator="ne"/>                           
                        </Fallback>

                        <Fallback>
                            <Sequence>
                                <CheckValue value="{stage_time}" expected="300" operator="gt"/>
                                <Fallback>
                                    <!-- 巡航点0: x="0.0" y="3.0" -->
                                    <Sequence>
                                        <CheckValue value="{cruise_state}" expected="0" operator="eq"/>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Nav x="-6.04" y="12.5" />
                                        </ReactiveSequence>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Guardian guard_duration = "7.0"/>
                                        </ReactiveSequence>
                                        <CruiserStateManager cruise_state_in = "{cruise_state}"
                                                            cruise_state_out = "{cruise_state}"
                                                            total_points = "{global_total_points}" />
                                    </Sequence>

                                    <!-- 巡航点1: x="0.0" y="6.0" -->
                                    <Sequence>
                                        <CheckValue value="{cruise_state}" expected="1" operator="eq"/>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Nav x="-6.43" y="14.8" />
                                        </ReactiveSequence>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Guardian guard_duration = "7.0"/>
                                        </ReactiveSequence>
                                        <CruiserStateManager cruise_state_in = "{cruise_state}"
                                                            cruise_state_out = "{cruise_state}"
                                                            total_points = "{global_total_points}" />
                                    </Sequence>
                                </Fallback>
                            </Sequence>

                            <Sequence>
                                <CheckValue value="{stage_time}" expected="300" operator="le"/>
                                <CheckValue value="{stage_time}" expected="180" operator="gt"/>
                                <Fallback>
                                    <!-- 巡航点0: x="0.0" y="3.0" -->
                                    <Sequence>
                                        <CheckValue value="{cruise_state}" expected="0" operator="eq"/>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Nav x="-2.1" y="11.2" />
                                        </ReactiveSequence>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Guardian guard_duration = "7.0"/>
                                        </ReactiveSequence>
                                        <CruiserStateManager cruise_state_in = "{cruise_state}"
                                                            cruise_state_out = "{cruise_state}"
                                                            total_points = "{global_total_points}" />
                                    </Sequence>

                                    <!-- 巡航点1: x="0.0" y="6.0" -->
                                    <Sequence>
                                        <CheckValue value="{cruise_state}" expected="1" operator="eq"/>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Nav x="-2.38" y="9.08" />
                                        </ReactiveSequence>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Guardian guard_duration = "7.0"/>
                                        </ReactiveSequence>
                                        <CruiserStateManager cruise_state_in = "{cruise_state}"
                                                            cruise_state_out = "{cruise_state}"
                                                            total_points = "{global_total_points}" />
                                    </Sequence>
                                </Fallback>
                            </Sequence>

                            <Sequence>
                                <CheckValue value="{stage_time}" expected="180" operator="le"/>
                                <CheckValue value="{stage_time}" expected="60" operator="gt"/>
                                <Fallback>
                                    <!-- 巡航点0: x="0.0" y="3.0" -->
                                    <Sequence>
                                        <CheckValue value="{cruise_state}" expected="0" operator="eq"/>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Nav x="-5.57" y="4.19" />
                                        </ReactiveSequence>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Guardian guard_duration = "7.0"/>
                                        </ReactiveSequence>
                                        <CruiserStateManager cruise_state_in = "{cruise_state}"
                                                            cruise_state_out = "{cruise_state}"
                                                            total_points = "{global_total_points}" />
                                    </Sequence>

                                    <!-- 巡航点1: x="0.0" y="6.0" -->
                                    <Sequence>
                                        <CheckValue value="{cruise_state}" expected="1" operator="eq"/>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Nav x="-6.11" y="2.2" />
                                        </ReactiveSequence>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Guardian guard_duration = "7.0"/>
                                        </ReactiveSequence>
                                        <CruiserStateManager cruise_state_in = "{cruise_state}"
                                                            cruise_state_out = "{cruise_state}"
                                                            total_points = "{global_total_points}" />
                                    </Sequence>
                                </Fallback>
                            </Sequence>

                            <Sequence>
                                <CheckValue value="{stage_time}" expected="60" operator="le"/>
                                <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                <Fallback>
                                    <!-- 巡航点0: x="0.0" y="3.0" -->
                                    <Sequence>
                                        <CheckValue value="{cruise_state}" expected="0" operator="eq"/>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Nav x="3.39" y="1.62" />
                                        </ReactiveSequence>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Guardian guard_duration = "7.0"/>
                                        </ReactiveSequence>
                                        <CruiserStateManager cruise_state_in = "{cruise_state}"
                                                            cruise_state_out = "{cruise_state}"
                                                            total_points = "{global_total_points}" />
                                    </Sequence>

                                    <!-- 巡航点1: x="0.0" y="6.0" -->
                                    <Sequence>
                                        <CheckValue value="{cruise_state}" expected="1" operator="eq"/>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Nav x="4.11" y="8.76" />
                                        </ReactiveSequence>
                                        <ReactiveSequence>
                                            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                            <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                            <Guardian guard_duration = "7.0"/>
                                        </ReactiveSequence>
                                        <CruiserStateManager cruise_state_in = "{cruise_state}"
                                                            cruise_state_out = "{cruise_state}"
                                                            total_points = "{global_total_points}" />
                                    </Sequence>
                                </Fallback>
                            </Sequence>
                        </Fallback>

                        
                    </Sequence>

                    <!-- 触发处理 -->
                    <Sequence>
                        <DoubleCheckValue value="{trigger_point_x}" expected="0" operator="eq"/>
                        <DoubleCheckValue value="{trigger_point_y}" expected="0" operator="eq"/>
                        <CheckValue value="{friend_outpost}" expected="0" operator="eq"/>
                        <Fallback>
                            <!-- 巡航点0: x="0.0" y="3.0" -->
                            <Sequence>
                                <CheckValue value="{cruise_state}" expected="0" operator="eq"/>
                                <ReactiveSequence>
                                    <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                    <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                    <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                    <Nav x="0.173" y="18.9" />
                                </ReactiveSequence>
                                <ReactiveSequence>
                                    <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                    <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                    <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                    <Guardian guard_duration = "7.0"/>
                                </ReactiveSequence>
                                <CruiserStateManager cruise_state_in = "{cruise_state}"
                                                    cruise_state_out = "{cruise_state}"
                                                    total_points = "{global_total_points}" />
                            </Sequence>

                            <!-- 巡航点1: x="0.0" y="6.0" -->
                            <Sequence>
                                <CheckValue value="{cruise_state}" expected="1" operator="eq"/>
                                <ReactiveSequence>
                                    <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                    <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                    <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                    <Nav x="2.27" y="16.6" />
                                </ReactiveSequence>
                                <ReactiveSequence>
                                    <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                                    <CheckValue value="{current_hp}" expected="100" operator="gt"/>
                                    <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                                    <Guardian guard_duration = "7.0"/>
                                </ReactiveSequence>
                                <CruiserStateManager cruise_state_in = "{cruise_state}"
                                                    cruise_state_out = "{cruise_state}"
                                                    total_points = "{global_total_points}" />
                            </Sequence>
                        </Fallback>
                    </Sequence>
                </Fallback>
            </Sequence>

            <!-- 低血量分支 -->
            <Sequence>
                <ReactiveSequence>
                    <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                    <Fallback> <!-- 满足血量低或没有弹丸 -->
                        <CheckValue value="{current_hp}" expected="100" operator="le"/> <!-- le表示小于等于 -->
                        <CheckValue value="{bullet_17mm}" expected="20" operator="le"/>
                    </Fallback>
                    <!-- <LogMessage message="血量不足或弹丸不够，返回补给区"/> -->
                    <Nav x="5.35" y="-1.82" />
                </ReactiveSequence>
                <ReactiveSequence>
                    <LogMessage message="等待血量恢复:{current_hp}"/>
                    <CheckValue value="{stage_time}" expected="0" operator="gt"/>
                    <Inverter> <!-- 若不满足两条件，则返回success，继续在reactive sequence中循环，直到满足条件返回false 退出-->
                        <Sequence>
                        <CheckValue value="{current_hp}" expected="300" operator="gt"/> <!-- gt表示大于等于 -->
                        <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
                        </Sequence>
                    </Inverter>
                    <Guardian guard_duration = "15.0"/>
                </ReactiveSequence>
            </Sequence>
        </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="RefereeSubscriber" editable="true">
      <input_port name="topic"/>
      <output_port name="competition_type"/>
      <output_port name="competition_stage"/>
      <output_port name="stage_time"/>
      <output_port name="robot_id"/>
      <output_port name="bullet_17mm"/>
      <output_port name="current_hp"/>
    </Action>
    <Action ID="RadarSubscriber" editable="true">
      <output_port name="robot_1_x"/>
      <output_port name="robot_1_y"/>
    </Action>
    <Action ID="Nav" editable="true">
      <input_port name="x"/>
      <input_port name="y"/>
    </Action>
    <Action ID="Guardian" editable="true">
      <input_port name="guard_duration"/>
    </Action>
  </TreeNodesModel>

</root>

