<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <!-- 主行为树 (含区域任务: 狗洞通行) -->
    <BehaviorTree ID="MainTree">
        <Sequence>
            <LogMessage message="检查比赛类型，比赛类型为：{competition_type}"/>
            <CheckValue value="{competition_type}" expected="1" operator="eq"/>
            <ReactiveFallback>
                <SubTree ID="Stage5_GameOver" _autoremap="true"/>
                <SubTree ID="Stage4_Combat" _autoremap="true"/>
            </ReactiveFallback>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Stage4_Combat">
        <Sequence>
            <CheckValue value="{competition_stage}" expected="4" operator="eq"/>
            <CheckValue value="{stage_time}" expected="0" operator="gt"/>
            <ReactiveFallback>
                <SubTree ID="DangerRetreat" _autoremap="true"/>
                <SubTree ID="HealthTactics" _autoremap="true"/>
            </ReactiveFallback>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="DangerRetreat">
        <ReactiveSequence>
            <Fallback>
                <DoubleCheckValue value="{current_hp}" trigger_value="200" trigger_operator="le" exit_value="350" exit_operator="gt" flag_name="is_recovering" blackboard_key="current_hp" />
                <CheckValue value="{bullet_17mm}" expected="20" operator="le"/>
            </Fallback>
            <Sequence>
                <ReactiveSequence>
                    <Nav x="2.55" y="2.46" />
                </ReactiveSequence>
                <ReactiveSequence>
                    <LogMessage message="等待血量或弹丸恢复"/>
                    <Guardian guard_duration="5.0"/>
                </ReactiveSequence>
            </Sequence>
        </ReactiveSequence>
    </BehaviorTree>

    <BehaviorTree ID="HealthTactics">
        <Sequence>
            <CheckValue value="{current_hp}" expected="200" operator="gt"/>
            <CheckValue value="{bullet_17mm}" expected="20" operator="gt"/>
            <LogMessage message="血量健康，执行区域任务分配"/>

            <ReactiveFallback>
                <!-- P0: 区域任务(狗洞通行): 不小陀螺 + 正对洞口 -->
                <SubTree ID="ZoneTask_DogHole" _autoremap="true"/>

                <!-- P1: 触发式信号 -->
                <SubTree ID="TriggeredTask" _autoremap="true"/>

                <!-- P2: 推前哨站 -->
                <SubTree ID="DefenseOutpost" _autoremap="true"/>

                <!-- P3: 主动巡航 -->
                <SubTree ID="CruiseTask" _autoremap="true"/>
            </ReactiveFallback>
        </Sequence>
    </BehaviorTree>

    <!-- 狗洞区域任务: 进入狗洞区后关小陀螺 + 正对洞口穿过 -->
    <BehaviorTree ID="ZoneTask_DogHole">
        <Sequence>
            <!-- 条件: 当前在 dog_hole 区域内 -->
            <CheckZone zone_name="dog_hole" in_zone="{in_zone}" zone_nav_yaw="{zone_yaw}" zone_spin="{zone_spin}"/>
            <LogMessage message="进入狗洞区域，关闭小陀螺并正对洞口"/>

            <!-- 关闭小陀螺 -->
            <SetSpin spin="false"/>

            <!-- 导航穿过狗洞(正对洞口 yaw) -->
            <ReactiveSequence>
                <Nav x="5.12" y="3.2" yaw="{zone_yaw}"/>
            </ReactiveSequence>

            <!-- 穿过洞口后驻守观察(小陀螺保持关闭) -->
            <ReactiveSequence>
                <LogMessage message="已穿过狗洞，驻守观察"/>
                <Guardian guard_duration="3.0"/>
            </ReactiveSequence>

            <!-- 离开后恢复小陀螺 -->
            <SetSpin spin="true"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="TriggeredTask">
        <Sequence>
            <CheckValue value="{trigger_flag}" expected="1" operator="eq"/>
            <LogMessage message="收到触发式消息，前往目标点并驻守"/>
            <ReactiveSequence>
                <Nav x="{trigger_point_x}" y="{trigger_point_y}" />
            </ReactiveSequence>
            <ReactiveSequence>
                <LogMessage message="到达触发点，开始驻守并准备清理标志位"/>
                <Guardian guard_duration="8.0"/>
            </ReactiveSequence>
            <ClearFlagNode flag_name="trigger_flag" expected_value="0"/>
            <LogMessage message="触发式任务完成，标志位已归零"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="DefenseOutpost">
        <ReactiveSequence>
            <CheckValue value="{enemy_outpost_status}" expected="0" operator="eq"/>
            <CheckValue value="{stage_time}" expected="330" operator="gt"/>
            <Sequence>
                <ReactiveSequence>
                    <Nav x="11.6" y="12.8" />
                </ReactiveSequence>
                <ReactiveSequence>
                    <PublishNavOutput target_tf_name="outpost" mode="1"/>
                    <Guardian guard_duration="5.0"/>
                </ReactiveSequence>
            </Sequence>
        </ReactiveSequence>
    </BehaviorTree>

    <BehaviorTree ID="CruiseTask">
        <Sequence>
            <ReactiveSequence>
                <Nav x="8.07" y="9.08" />
            </ReactiveSequence>
            <ReactiveSequence>
                <GuardWithAttack guard_duration="240.0" move_radius="8.0" engage_distance="2.0" occ_threshold="20" nav_update_interval="1.0" sense_radius="11.5"/>
            </ReactiveSequence>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Stage5_GameOver">
        <ReactiveSequence>
            <CheckValue value="{competition_stage}" expected="4" operator="ne"/>
            <Sequence>
                <LogMessage message="非阶段4，导航纠偏，防止打滑..."/>
                <ClearFlagNode flag_name="small_rune_flag_1" expected_value="0"/>
                <ClearFlagNode flag_name="small_rune_flag_2" expected_value="0"/>
                <ClearFlagNode flag_name="big_rune_flag_1" expected_value="0"/>
                <ClearFlagNode flag_name="big_rune_flag_2" expected_value="0"/>
                <ClearFlagNode flag_name="big_rune_flag_3" expected_value="0"/>
                <ClearFlagNode flag_name="trigger_flag" expected_value="0"/>
                <ReactiveSequence>
                    <Nav x="3.9" y="7.5" />
                </ReactiveSequence>
                <ReactiveSequence>
                    <Guardian guard_duration="4.0"/>
                </ReactiveSequence>
            </Sequence>
        </ReactiveSequence>
    </BehaviorTree>

    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Action ID="RefereeSubscriber" editable="true">
            <input_port name="topic"/>
            <output_port name="competition_type"/>
            <output_port name="competition_stage"/>
            <output_port name="stage_time"/>
            <output_port name="robot_id"/>
            <output_port name="bullet_17mm"/>
            <output_port name="current_hp"/>
        </Action>
        <Action ID="RadarSubscriber" editable="true">
            <output_port name="robot_1_x"/>
            <output_port name="robot_1_y"/>
        </Action>
        <Action ID="Nav" editable="true">
            <input_port name="x"/>
            <input_port name="y"/>
            <input_port name="yaw"/>
        </Action>
        <Action ID="CheckZone" editable="true">
            <input_port name="zone_name"/>
            <output_port name="in_zone"/>
            <output_port name="zone_nav_yaw"/>
            <output_port name="zone_spin"/>
        </Action>
        <Action ID="SetSpin" editable="true">
            <input_port name="spin"/>
        </Action>
        <Action ID="PublishNavOutput" editable="true">
            <input_port name="target_tf_name"/>
            <input_port name="mode"/>
        </Action>
        <Action ID="RuneStateMachine" editable="true">
            <input_port name="flag_name"/>
            <input_port name="status_key"/>
            <input_port name="target_state"/>
        </Action>
        <Action ID="ClearFlagNode" editable="true">
            <input_port name="flag_name"/>
            <input_port name="expected_value"/>
        </Action>
        <Action ID="Guardian" editable="true">
            <input_port name="guard_duration"/>
        </Action>
    </TreeNodesModel>

</root>
